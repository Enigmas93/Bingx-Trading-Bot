# ===== BingX =====
BINGX_API_KEY=
BINGX_API_SECRET=
# true = conta DEMO (VST, dinheiro fictício). Mude para false SOMENTE quando tiver certeza.
BINGX_TESTNET=true
# Trava de segurança desta versão: execução SOMENTE em DEMO. O sistema recusa operar com qualquer outro valor.
DEMO_MODE=true
LIVE_TRADING=false

# ===== Notícias / dados macro =====
# false = desliga toda a checagem de notícias (trade segue sem ajuste)
NEWS_ENABLED=true
COINMARKETCAL_API_KEY=
BLS_API_KEY=
BEA_API_KEY=

# ===== NVIDIA NIM (IA que classifica as notícias) =====
# Se vazio, a checagem de notícias é ignorada.
NVIDIA_API_KEY=
NEWS_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# ===== App =====
DATABASE_URL=sqlite:///./bot.db
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_ORIGIN=http://localhost:3000
# false = não inicia os jobs automáticos de 5 em 5 minutos (útil para testes)
SCHEDULER_ENABLED=true

# Token entre o painel e o backend (gerado automaticamente; o mesmo valor vai no painel/Vercel)
BOT_API_TOKEN=
